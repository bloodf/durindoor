{
  "extends": ["@commitlint/config-conventional"],
  "rules": {
    "type-enum": [2, "always", ["feat", "fix", "docs", "style", "refactor", "perf", "test", "ci", "chore", "revert", "port", "merge", "sync"]],
    "header-max-length": [0],
    "subject-case": [0],
    "subject-empty": [0],
    "type-empty": [0],
    "subject-max-length": [2, "always", 100],
    "body-max-line-length": [1, "always", 200],
    "footer-max-line-length": [0]
  }
}
