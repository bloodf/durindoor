# DurinDoor environment contract
# Copy to .env and fill in every CHANGE_ME value before deployment.

# Required — dashboard session signing (GHSA-jphh). Prefer an explicit value.
# Generate with: openssl rand -hex 32
# Legacy: if DATA_DIR/jwt-secret already exists from an older install, that file
# is still accepted with a warning; DurinDoor no longer auto-generates it.
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
INITIAL_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# DATA_DIR is set explicitly at deployment time.
# It must be a persistent path the application can write to.
# Common choices:
#   - /var/lib/durindoor       (system service, recommended for servers)
#   - /opt/durindoor/data
#   - $HOME/.durindoor         (bind mount host path, typical for Docker)
# The directory is created automatically if it does not exist.
# In Docker, DATA_DIR is always /app/data to match the container's volume mount.
DATA_DIR=/var/lib/durindoor

# Runtime
PORT=20128
NODE_ENV=production

# Optional 429 account/model lock backoff (#3352). Defaults: 2 seconds,
# capped at 5 minutes, with at most 15 levels. Values must be positive integers;
# maximum delay is capped at 7 days. Max below base resets all defaults.
# BACKOFF_BASE_MS=2000
# BACKOFF_MAX_MS=300000
# BACKOFF_MAX_LEVEL=15

# Per-account RPM admission is dashboard-configured under Providers (#3203),
# not an environment variable. Blank defaults NVIDIA to 40 RPM and leaves other
# providers unlimited; 0 explicitly disables the cap.

# Security — REQUIRED in production
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
API_KEY_SECRET=
MACHINE_ID_SALT=endpoint-proxy-salt
ENABLE_REQUEST_LOGS=false
AUTH_COOKIE_SECURE=false

# Server-side base URL (used by callbacks and selected routes)
BASE_URL=http://localhost:20128

# Browser-visible base URL
NEXT_PUBLIC_BASE_URL=http://localhost:20128

# Firecrawl web fetch provider
# Leave FIRECRAWL_API_KEY empty to route to a self-hosted instance.
FIRECRAWL_BASE_URL=https://api.firecrawl.dev
FIRECRAWL_API_KEY=
FIRECRAWL_TIMEOUT_MS=30000
FIRECRAWL_DEFAULT_FORMAT=markdown

# Optional outbound proxy for upstream provider calls
# Lowercase variants are also supported: http_proxy, https_proxy, all_proxy, no_proxy
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# Optional SearXNG endpoint for the built-in unauthenticated web-search provider.
# SEARXNG_URL=http://searxng:8080/search

# Optional timeout tuning for Ollama Local provider (default: 120000ms).
# Increase if large models (e.g. 70B+) are slow to respond with first tokens.
# OLLAMA_LOCAL_CONNECT_TIMEOUT_MS=120000

# Claude SSE ping interval during upstream silence (default: 10000ms).
# Set 0 to disable early-handler and post-translation keepalives.
# SSE_KEEPALIVE_MS=10000

# CodeBuddy CN replaces system prompts matching coding-agent identity markers.
# Prompts longer than this limit also match; set 0 to disable only the length rule.
# Invalid values use the 2000-character default (decolua/9router#3342).
# RTK caveman/ponytail injection adds roughly 1.7-1.9k characters to the system
# message; codebuddy-cn operators using RTK should raise this limit or set 0.
# CODEBUDDY_SYSTEM_PROMPT_MAX_LEN=2000

# Dashboard bind address. Defaults to 127.0.0.1 (loopback only). The dashboard
# exposes privileged endpoints (tunnel install, daemon start) that run system
# commands — do NOT set HOSTNAME=0.0.0.0 on a public network without a reverse
# proxy with authentication in front of it.
# HOSTNAME=127.0.0.1
