{
  "manifest_version": 3,
  "name": "DurinDoor Cookie Capture",
  "version": "0.1.0",
  "description": "Send one signed-in provider session to your own DurinDoor dashboard, only when you ask and confirm.",
  "action": {
    "default_title": "DurinDoor Cookie Capture",
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab"],
  "optional_permissions": ["cookies", "scripting"],
  "optional_host_permissions": [
    "https://web.chatplayground.ai/*",
    "https://arena.ai/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://grok.com/*",
    "https://www.maxai.co/*",
    "https://www.meta.ai/*",
    "https://www.perplexity.ai/*",
    "https://yuanbao.tencent.com/*",
    "https://chat.z.ai/*",
    "https://chat.deepseek.com/*",
    "https://www.dola.com/*",
    "https://prompt.ql.app/*",
    "https://app.notion.com/*",
    "https://notrack.ai/*",
    "https://aistudio.tencent.ai/*",
    "https://app.blackbox.ai/*",
    "https://conol.ai/*",
    "https://site.tinycms.xyz/*",
    "https://www.poe.com/*",
    "https://v0.dev/*",
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://[::1]/*"
  ]
}
