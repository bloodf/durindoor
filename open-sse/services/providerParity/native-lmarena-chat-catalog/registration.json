    {
      "file": "open-sse/providers/registry/lmarena.js",
      "change": "models = buildLmarenaChatRegistryModels(models) (48 rows; the 7 existing rows keep their name and contextLength). Keep cookieCaptureProfile, cookieImport, authType cookie, serviceKinds [\"llm\"]."
    },
    {
      "file": "open-sse/executors/lmarena.js",
      "change": "in runChat, call resolveLmarenaChatModel(model) before reading the cookie; on ok:false return { response: lmarenaChatRefusalResponse(result), url: URL, headers: {}, transformedBody: null } with no send; on ok pass result.arenaModelId to upstreamBody instead of ALLOW[model] || model, then delete ALLOW. Keep the cookie, TLS, proxy scope, billing, abort and stream code unchanged."
    },
    {
      "file": "tests/unit/lmarena-provider.test.js",
      "change": "none required; its claude-haiku-4-5-20251001 UUID is unchanged"
