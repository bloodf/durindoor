  "provider": {
    "canonicalId": "vertex",
    "aliases": ["vx"],
    "existingRegistryFile": "open-sse/providers/registry/vertex.js",
    "existingServiceKinds": ["llm", "imageToText"],
    "addServiceKinds": ["tts", "stt"],
    "notTouched": ["vertex-partner"],
    "connectionModes": [
      "Service Account JSON in apiKey (bearer minted by services/tokenRefresh.js refreshVertexToken; project from project_id)",
      "ADC authorized_user JSON in apiKey (bearer from refreshGoogleToken; project from quota_project_id or providerSpecificData.projectId)",
      "pre-set accessToken (project from providerSpecificData.projectId)",
      "Express API key in apiKey (project-less global publisher endpoint, ?key=)"
    ],
    "scope": {
      "location": "providerSpecificData.location, default us-central1; global, us, eu or <area>-<region><n>",
      "project": "never inferred from a raw API key; no project-discovery probe is sent"
    }
  },
  "services": {
    "tts": {
      "format": "vertex-gemini-tts",
      "config": "VERTEX_TTS_CONFIG",
      "adapter": "default export of speech.js (createVertexTtsAdapter())",
      "models": [
        "gemini-3.1-flash-tts-preview",
        "gemini-2.5-flash-preview-tts",
        "gemini-2.5-pro-preview-tts",
        "gemini-3.8-flash-tts",
        "gemini-3.8-flash-lite-tts"
      ],
      "defaultVoice": "Kore",
      "voiceDiscovery": "listVertexTtsVoices() (Gemini prebuilt voices, handlers/ttsProviders/gemini.js fetchGeminiVoices)",
      "responseFormats": ["wav", "pcm", "json"],
      "endpoint": {
        "bearer": "POST https://{location}-aiplatform.googleapis.com/v1/projects/{project}/locations/{location}/publishers/google/models/{model}:generateContent (global: aiplatform.googleapis.com; us/eu: aiplatform.{us|eu}.rep.googleapis.com)",
        "express": "POST https://aiplatform.googleapis.com/v1/publishers/google/models/{model}:generateContent?key={key}",
        "headers": ["Content-Type: application/json", "Authorization: Bearer {token} (bearer modes only)"]
      }
    },
    "stt": {
      "format": "vertex-gemini",
      "config": "VERTEX_STT_CONFIG",
      "transcriber": "transcribeVertex (createVertexSttTranscriber())",
      "models": ["gemini-2.5-flash", "gemini-2.5-pro"],
      "retiredModels": [
        {
          "id": "gemini-2.0-flash",
          "retired": "2026-06-01",
          "evidence": "https://docs.cloud.google.com/gemini-enterprise-agent-platform/models/model-versions",
          "checked": "2026-11-27",
          "handling": "dropped from the source list; requests naming it get 400 before any token mint or HTTP call"
        }
      ],
      "responseFormats": ["json", "text"],
      "formFields": ["file", "model", "language", "prompt", "response_format"],
      "translations": false,
      "endpoint": "same generateContent endpoint and headers as tts"
    }
  },
  "exports": {
    "index.js": "re-exports everything below",
    "config.js": [
      "VERTEX_AUDIO_PROVIDER_ID", "VERTEX_AUDIO_PROVIDER_ALIASES", "VERTEX_AUDIO_SOURCE_BASE_URL", "VERTEX_AUDIO_DEFAULT_LOCATION",
      "VERTEX_TTS_FORMAT", "VERTEX_STT_FORMAT", "VERTEX_TTS_MODELS", "VERTEX_STT_MODELS", "VERTEX_TTS_MODEL_IDS", "VERTEX_STT_MODEL_IDS",
      "VERTEX_TTS_DEFAULT_VOICE", "VERTEX_TTS_RESPONSE_FORMATS", "VERTEX_STT_RESPONSE_FORMATS", "VERTEX_STT_AUDIO_MIME_TYPES",
      "VERTEX_TTS_CONFIG", "VERTEX_STT_CONFIG", "listVertexAudioModels", "bounds: VERTEX_TTS_MAX_*, VERTEX_STT_MAX_*, VERTEX_AUDIO_*_TIMEOUT_MS"
    ],
    "auth.js": ["resolveVertexAudioAuth", "vertexGenerateContentRequest", "vertexLocationOrigin", "VERTEX_GLOBAL_ORIGIN", "boundedWait"],
    "request.js": ["sendVertexGenerateContent", "vertexAudioAcceptedJob", "vertexAbortedResult", "vertexUnusableResult"],
    "speech.js": [
      "default (TTS adapter)", "createVertexTtsAdapter", "buildVertexSpeechRequest", "listVertexTtsVoices", "normalizeVertexAudio",
      "vertexUsageAccounting", "extractSpeechInstruction", "buildGeminiSpeechStyle", "pcmToWav", "parsePcmSampleRate", "stripC2paMetadata"
    ],
    "transcription.js": [
      "transcribeVertex", "createVertexSttTranscriber", "buildVertexTranscriptionRequest", "extractVertexTranscript",
      "resolveVertexAudioMime", "vertexTranscriptionInstruction"
    ]
  },
  "integrationPoints": [
