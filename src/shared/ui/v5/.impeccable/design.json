  "narrative": {
    "northStar": "Operate mode",
    "overview": "Operate mode puts gateway tasks beside their current state and a visible next action. Neutral light surfaces and forest graphite dark surfaces use thin borders to separate navigation, summaries, widgets, tables, and forms. Emerald marks actions, focus, and the current route. Inter carries the interface; the doorway mark connects it to DurinDoor.\n\nThis records the implemented Storybook proposal under src/shared/ui/v5. The direction and descriptive language are builder assumptions pending user review, not aesthetic approval or a v5 release. The root PRODUCT.md, DESIGN.md, and .impeccable/design.json describe public marketing and documentation; their expressive gateway world stays outside this admin token system.",
    "keyCharacteristics": [
      "Border-defined hierarchy in light and dark themes.",
      "Task groups, collapsible navigation, and keyboard page search.",
      "Editable dashboard widgets with explicit draft, save, and cancel states.",
      "Local sample workflows with reversible changes and protected forms."
    ],
    "rules": [
      {
        "name": "The State Accent Rule",
        "body": "Use emerald for actions, focus, and the current route. Preserve separate semantic status and chart-series colors, and pair statuses with readable labels.",
        "section": "colors"
      },
      {
        "name": "The Task Density Rule",
        "body": "Use the compact Inter hierarchy for operational controls. Keep page titles distinct from widget titles and retain tabular numerals for metrics.",
        "section": "typography"
      },
      {
        "name": "The Contained Table Rule",
        "body": "Keep wide inventories inside their horizontal scroll container. Stack dashboard widgets before the page itself needs horizontal scrolling.",
        "section": "layout"
      },
      {
        "name": "The Flat Panel Rule",
        "body": "Use surface tone and thin borders for resting widgets and panels. Reserve the shared elevation shadow for dialogs and transient notifications.",
        "section": "elevation"
      },
      {
        "name": "The Explicit Commit Rule",
        "body": "Keep layout edits in a draft until Save layout. Cancel can request discard confirmation; changes do not persist to the production application.",
        "section": "components"
      }
    ],
    "dos": [
      "Do use the scoped theme tokens for controls, surfaces, focus, and semantic status.",
      "Do retain text labels alongside icons and status colors.",
      "Do preserve pointer dragging, keyboard dragging, and move buttons for widget ordering.",
      "Do show save, cancel, validation, and undo feedback for local changes.",
      "Do honor reduced motion and retain usable static state feedback.",
      "Do identify sample data and keep prototype actions local."
    ],
    "donts": [
      "Don't apply marketing serif displays, stone artwork, or cinematic gateway motion to admin controls.",
      "Don't hide operational content behind motion.",
      "Don't remove keyboard movement or native dialog focus behavior when extending the proposal.",
      "Don't describe sample saving, testing, authentication, translator output, or metrics as production integration.",
      "Don't treat this document or review screenshots as user acceptance."
    ]
  }
