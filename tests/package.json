{
  "name": "9router-tests",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Test suite for 9router (open-sse handlers, translator, executors, db, security)",
  "scripts": {
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest --reporter=verbose",
    "test:json": "vitest run --reporter=json --outputFile=./.test-results.json",
    "gate": "node __baseline__/verify-no-regression.mjs ./.test-results.json",
    "test:ci": "node __baseline__/run-ci.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "happy-dom": "^21.0.4",
    "jsonc-parser": "^3.3.1",
    "playwright": "1.63.0",
    "vitest": "^4.1.12",
    "@testing-library/dom": "10.4.2",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "packageManager": "pnpm@12.18.0",
  "dependencies": {
    "uuid": "^14.0.1"
  }
}
