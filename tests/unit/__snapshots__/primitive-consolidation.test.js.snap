exports[`preserves legacy Card heading and action with V5 false 1`] = `"<div class="min-w-0 rounded-dd-lg border border-dd-border bg-dd-surface p-5"><div class="mb-4 flex min-w-0 flex-wrap items-center justify-between gap-3"><div class="flex min-w-0 flex-1 basis-40 items-center gap-3"><div class="min-w-0"><h3 class="break-words text-sm font-semibold text-dd-text">Account</h3><p class="mt-0.5 break-words text-xs text-dd-muted">Details</p></div></div><div class="ml-auto flex min-w-0 max-w-full flex-wrap items-center justify-end gap-1.5"><button type="button">Edit</button></div></div>Content</div>"`;

exports[`preserves legacy Drawer dialog and close action with V5 false 1`] = `"<dialog tabindex="-1" aria-labelledby="_r_0_" class="fixed inset-0 m-0 flex h-full w-full max-w-none items-stretch justify-end overflow-hidden border-0 bg-transparent p-0 backdrop:bg-dd-backdrop backdrop:backdrop-blur-sm rtl:justify-start [&amp;:not([open])]:hidden " open=""><section role="document" style="width: 400px;" class="slide-in-right flex h-full min-w-0 max-w-full flex-col border-s border-dd-border bg-dd-surface shadow-dd-elevated motion-reduce:animate-none "><header class="flex min-w-0 flex-wrap items-start justify-between gap-3 border-b border-dd-border-subtle px-4 py-4 sm:px-5"><div class="flex min-w-0 flex-1 basis-48 flex-col gap-0.5 break-words"><h2 id="_r_0_" class="text-base font-semibold text-dd-text break-words">Details</h2></div><button type="button" aria-label="Close" class="-mr-2 -mt-2 flex h-11 w-11 shrink-0 items-center justify-center rounded-dd text-dd-muted outline-none transition-colors hover:bg-dd-surface-2 hover:text-dd-text focus-visible:shadow-dd-focus disabled:cursor-not-allowed disabled:opacity-50 motion-reduce:transition-none"><span aria-hidden="true" class="material-symbols-outlined text-[20px] leading-none">close</span></button></header><div class="min-h-0 min-w-0 flex-1 overflow-y-auto px-4 py-4 text-[13px] leading-relaxed text-dd-text sm:px-5">Body</div></section></dialog>"`;

exports[`preserves legacy Pagination controls with V5 false 1`] = `"<div class="flex flex-col items-center justify-between gap-4 py-4 px-2 sm:flex-row"><div class="text-xs text-dd-muted">Showing 1 to 20 of 45 results</div><nav aria-label="Pagination" class="flex flex-wrap items-center gap-x-4 gap-y-2"><label class="flex items-center gap-1.5 text-xs text-dd-muted">Rows:<span class="relative inline-block"><select aria-label="Rows per page" class="h-11 rounded-dd border border-dd-border bg-dd-surface pe-4 ps-3 text-xs text-dd-text outline-none hover:border-dd-border-subtle focus-visible:border-dd-accent focus-visible:shadow-dd-focus"><option value="10">10</option><option value="20">20</option><option value="25">25</option><option value="50">50</option><option value="100">100</option><option value="all">All</option></select></span></label><div class="ms-auto flex items-center gap-1"><button type="button" aria-label="Previous page" disabled="" class="flex min-h-11 min-w-11 items-center justify-center rounded-dd px-3 text-dd-muted outline-none transition-colors hover:bg-dd-surface-2 hover:text-dd-text focus-visible:shadow-dd-focus disabled:pointer-events-none disabled:opacity-40"><span aria-hidden="true" class="material-symbols-outlined rtl:rotate-180 text-[18px] leading-none">chevron_left</span></button><span class="whitespace-nowrap px-2 text-xs text-dd-muted sm:hidden" aria-label="Page 1 of 3">1 / 3</span><span class="hidden items-center gap-1 sm:flex"><button type="button" aria-label="Page 1" aria-current="page" class="flex min-h-11 min-w-11 items-center justify-center rounded-dd px-2 text-xs font-medium dd-tnum outline-none transition-colors focus-visible:shadow-dd-focus bg-dd-accent text-dd-on-accent">1</button><button type="button" aria-label="Page 2" class="flex min-h-11 min-w-11 items-center justify-center rounded-dd px-2 text-xs font-medium dd-tnum outline-none transition-colors focus-visible:shadow-dd-focus text-dd-muted hover:bg-dd-surface-2 hover:text-dd-text">2</button><button type="button" aria-label="Page 3" class="flex min-h-11 min-w-11 items-center justify-center rounded-dd px-2 text-xs font-medium dd-tnum outline-none transition-colors focus-visible:shadow-dd-focus text-dd-muted hover:bg-dd-surface-2 hover:text-dd-text">3</button></span><button type="button" aria-label="Next page" class="flex min-h-11 min-w-11 items-center justify-center rounded-dd px-3 text-dd-muted outline-none transition-colors hover:bg-dd-surface-2 hover:text-dd-text focus-visible:shadow-dd-focus disabled:pointer-events-none disabled:opacity-40"><span aria-hidden="true" class="material-symbols-outlined rtl:rotate-180 text-[18px] leading-none">chevron_right</span></button></div></nav></div>"`;
